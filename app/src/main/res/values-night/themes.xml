<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Dark Night Mode). -->
    <style name="Theme.MoonDay" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/cosmic_primary</item>
        <item name="colorPrimaryVariant">@color/cosmic_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/cosmic_secondary</item>
        <item name="colorSecondaryVariant">@color/cosmic_secondary</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/cosmic_background</item>
        <item name="colorSurface">@color/cosmic_surface</item>
        <item name="colorOnSurface">@color/cosmic_text_primary</item>
        <!-- Font & Default Text Style -->
        <item name="android:fontFamily">@font/fredoka</item>
        <item name="android:textViewStyle">@style/Widget.MoonDay.TitleText</item>
        <!-- Status bar & Navigation bar colors. -->
        <item name="android:statusBarColor">@color/cosmic_header_start</item>
        <item name="android:navigationBarColor">@color/cosmic_surface</item>
    </style>
</resources>
